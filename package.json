{
  "name": "muraton",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @muraton/web",
    "dev:backoffice": "npm run dev -w @muraton/backoffice",
    "build": "npm run build -w @muraton/web -w @muraton/backoffice",
    "build:web": "npm run build -w @muraton/web",
    "build:backoffice": "npm run build -w @muraton/backoffice",
    "start:web": "npm run start -w @muraton/web",
    "start:backoffice": "npm run start -w @muraton/backoffice",
    "lint": "npm run lint -w @muraton/web -w @muraton/backoffice",
    "db:generate": "npm run generate -w @muraton/db",
    "db:push": "npm run db:push -w @muraton/db",
    "db:seed": "npm run db:seed -w @muraton/web",
    "db:create-admin": "npm run create-admin -w @muraton/db"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
