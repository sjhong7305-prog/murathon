# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# user-uploaded content — real storage (S3/etc.) should replace this before scaling
/public/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

# hero images uploaded from the backoffice (see packages/shared/src/hero-uploads.ts)
/uploads
