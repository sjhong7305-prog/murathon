# Copy this file to `.env` (repo root). Both apps (apps/web, apps/backoffice) and the
# Prisma CLI (packages/db) read it. In production, set these on each app's host instead.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Shared secret the backoffice uses to ask the storefront to refresh pages after an edit.
# Set the same value for both apps. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=""

# Where the backoffice reaches the storefront (used with REVALIDATE_SECRET).
STOREFRONT_URL="http://localhost:3000"

# Optional: directory for hero images uploaded in the backoffice and served by both apps.
# Defaults to <repo>/uploads/hero. Must be the same disk/mount for both apps.
# HERO_UPLOAD_DIR=""
